# Shivam Patsanstha Backend Configuration
PROJECT_NAME="Shivam Patsanstha Digital Attendance Management System"
ORGANIZATION_NAME="Shivam Patsanstha"
ORGANIZATION_CODE="SHIVAM_PAT"

# Security Secrets (generate new random strings for production)
SECRET_KEY="sp-attendance-secret-key-change-in-production-2026-super-secure"
QR_SIGNING_SECRET="sp-qr-hmac-signing-secret-change-in-production-2026"
